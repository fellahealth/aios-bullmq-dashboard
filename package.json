{
  "name": "aios-bullmq-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, professional dashboard for BullMQ — built as a drop-in alternative to bull-board with a refreshed UI.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "dev:ui": "yarn workspace @aios/bullmq-dashboard-ui dev",
    "clean": "yarn workspaces run clean",
    "typecheck": "yarn workspaces run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
